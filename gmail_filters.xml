  <!-- Google security alerts -> Accounts, skip inbox -->
  <entry>
    <category term='filter'/>
    <title>Mail Filter</title>
    <apps:property name='from' value='no-reply@accounts.google.com'/>
    <apps:property name='hasTheWord' value='sign-in OR security alert OR recovered'/>
    <apps:property name='label' value='Accounts'/>
    <apps:property name='shouldArchive' value='true'/>
    <apps:property name='sizeOperator' value='s_sl'/>
    <apps:property name='sizeUnit' value='s_smb'/>
